#Template file for 'reform2-lpc-dkms'
pkgname=reform2-lpc-dkms
version=1.68
revision=1
archs="aarch64 aarch64-musl"
short_desc="lpc driver for MNT Reform devices (including the MNT Pocket Reform)"
maintainer="Joe Albanese <joe@joe-albanese.com>"
build_type="dkms"
dkms_modules="reform2_lpc ${version}"
depends="dkms zstd clang make"
triggers="dkms initramfs-regenerate"
distfiles="https://source.mnt.re/reform/reform-tools/-/archive/80e169578b7b15478b43406f607bc381215fc5a9/reform-tools-80e169578b7b15478b43406f607bc381215fc5a9.tar.gz"
checksum=9ce3cf806ba25fa86bca263d7eeb0919350e3a5860fec9b261a32b4e785eb265
homepage="https://source.mnt.re/reform/reform-tools"
license="AGPL-3.0-or-later"

do_install() {
	vmkdir usr/src/reform2_lpc-${version}
	vcopy lpc/* usr/src/reform2_lpc-${version}
	vcopy ${FILESDIR}/dkms.conf usr/src/reform2_lpc-${version}
	vlicense LICENSE.txt
}

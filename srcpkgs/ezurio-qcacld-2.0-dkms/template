do_install() {
	vmkdir usr/src/ezurio-qcacld-2.0-${version}
	vcopy CORE usr/src/ezurio-qcacld-2.0-${version}
	vcopy Kbuild usr/src/ezurio-qcacld-2.0-${version}
	vcopy Kconfig usr/src/ezurio-qcacld-2.0-${version}
	vcopy Makefile usr/src/ezurio-qcacld-2.0-${version}
	vcopy firmware_bin usr/src/ezurio-qcacld-2.0-${version}
	vcopy wcnss usr/src/ezurio-qcacld-2.0-${version}
	vcopy ${FILESDIR}/dkms.conf usr/src/ezurio-qcacld-2.0-${version}
	vlicense ${FILESDIR}/LICENSE.txt
}
